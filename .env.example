# TMDB API credentials
# Create an API key at: https://www.themoviedb.org/settings/api
# Use the "API Key (v3 auth)" value, not the "Read Access Token (v4 auth)".
# This key is used only by the local Node proxy and must not be exposed to the browser.
APP_API_KEY=your_tmdb_v3_api_key

# Shared access token for your TMDB proxy.
# Generate one locally with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# The same value must be configured as APP_PROXY_ACCESS_TOKEN for the frontend build.
PROXY_ACCESS_TOKEN=generate_a_long_random_token
APP_PROXY_ACCESS_TOKEN=generate_a_long_random_token

# Comma-separated list of browser origins allowed to call the proxy.
# For the local Stencil dev server, this is usually:
# http://localhost:3333
PROXY_ALLOWED_ORIGINS=http://localhost:3333

# Default language for TMDB requests, formatted as an IETF language tag.
# Examples: de-DE, en-US
APP_LANG=de-DE

# Base URL used by the Stencil frontend.
# For local development, point it to the Node proxy.
APP_API_BASE_URL=http://localhost:3001/api/tmdb

# Optional port for the local TMDB proxy.
PROXY_PORT=3001

# Finally rename this file to .env
